{
  "name": "Photoset Darkroom",
  "short_name": "Photoset",
  "description": "Retro film looks, film strips and batch JPG compression, right in your browser.",
  "start_url": ".",
  "scope": ".",
  "display": "standalone",
  "background_color": "#15120e",
  "theme_color": "#15120e",
  "icons": [
    { "src": "icon.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [{ "name": "photos", "accept": ["image/jpeg", ".jpg", ".jpeg", ".dng", ".cr3", ".arw"] }]
    }
  }
}
